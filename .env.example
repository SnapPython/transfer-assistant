FTA_TOKEN=replace-with-a-long-random-token
FTA_PORT=8787
# Host interface the container port is published on. Keep it on loopback and
# put a reverse proxy in front; widen it only for a deliberately public host.
FTA_BIND=127.0.0.1
FTA_MAX_UPLOAD_MB=512
FTA_MAX_TEXT_CHARS=200000
FTA_CORS_ORIGINS=
FTA_TOTP_SECRET=
FTA_WEB_AUTH_MODE=token_totp
FTA_LOGIN_LOCK_FAILURES=3
FTA_LOGIN_LOCK_SECONDS=900
FTA_PROXY_AUTH_SECRET=
